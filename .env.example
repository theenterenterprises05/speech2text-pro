# Server port
PORT=3000

# PostgreSQL connection string (production). If unset, the app runs with an
# in-memory store so `npm start` works immediately with zero setup.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/speech2text

# Optional: server-side AI transcription via Google Gemini (free key at
# https://aistudio.google.com/apikey). The core app works fully without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash
